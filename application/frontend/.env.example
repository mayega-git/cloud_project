# Where the Next.js server reaches the backend (server side only).
BACKEND_URL=http://127.0.0.1:3000
# Origin presented to the backend. It must equal the origin of the backend's
# AUTH_BASE_URL, because Better Auth refuses POST requests from another origin.
BACKEND_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional. Origin of the editor gateway; by default the current host on port 9001.
# NEXT_PUBLIC_EDITOR_ORIGIN=http://127.0.0.1:9001
