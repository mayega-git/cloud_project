# Public local development values; setup-local.sh creates secrets in .env.
PORT=3000
ETHERPAD_API_URL=http://127.0.0.1:9001
ETHERPAD_PUBLIC_URL=http://127.0.0.1:9001
ETHERPAD_API_KEY_FILE=../.secrets/APIKEY.txt
POSTGRES_PASSWORD=GENERATED_BY_SETUP_SCRIPT
ETHERPAD_ADMIN_PASSWORD=GENERATED_BY_SETUP_SCRIPT
APP_ENV=local
HOST=127.0.0.1
DATABASE_URL=postgresql://etherpad:GENERATED_BY_SETUP_SCRIPT@127.0.0.1:5432/etherpad
INTERNAL_KEY_FILE=../.secrets/INTERNAL_KEY.txt
BETTER_AUTH_SECRET_FILE=../.secrets/BETTER_AUTH_SECRET.txt
AUTH_BASE_URL=http://127.0.0.1:3000
INVITATION_LIFETIME_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
